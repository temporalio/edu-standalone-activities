<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss} %-5level %logger{0} - %msg%n</pattern>
    </encoder>
  </appender>
  <!-- Quiet the SDK's own chatter so the Activity log lines stand out in the demos. -->
  <logger name="io.temporal" level="WARN"/>
  <root level="INFO">
    <appender-ref ref="STDOUT"/>
  </root>
</configuration>
